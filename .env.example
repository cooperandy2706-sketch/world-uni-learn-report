# Acadera — copy to .env for local development.
# Never commit .env. Rotate any key that was ever committed to git.

# ============================================
# Supabase (Vite — browser-safe keys only)
# ============================================
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ============================================
# Paystack (master public key — Vite)
# ============================================
VITE_PAYSTACK_PUBLIC_KEY=pk_test_<your-key>

# ============================================
# Push notifications (Vite)
# ============================================
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>

# ============================================
# AI (optional — Vite)
# ============================================
VITE_GEMINI_API_KEY=<gemini-api-key>
VITE_GROQ_API_KEY=<groq-api-key>
VITE_HUGGINGFACE_API_KEY=<huggingface-api-key>
VITE_HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ============================================
# App
# ============================================
VITE_APP_NAME=Acadera
VITE_APP_URL=http://localhost:5173

# ============================================
# Supabase Edge Function secrets (NOT in .env)
# Set in: Supabase Dashboard → Project Settings → Edge Functions → Secrets
# ============================================
# SUPABASE_SERVICE_ROLE_KEY   — auto-injected on deploy
# SUPABASE_ANON_KEY           — auto-injected on deploy
# PAYSTACK_SECRET_KEY         — Paystack secret (sk_live_ / sk_test_)
# ARKESEL_API_KEY             — SMS (send-sms)
# VAPID_PRIVATE_KEY           — Web push (send-push)
# ALLOW_PAYMENT_SANDBOX=true  — optional; enables sandbox_* refs in verify-payment (dev only)
